{
  "manifest_version": 3,
  "name": "GAOCG SEI Bridge",
  "short_name": "GAOCG-SEI",
  "description": "Envia dados criados no app GAOCG (SOF, Notas de Empenho, Recibos) diretamente para um processo aberto no SEI.",
  "version": "0.48.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GAOCG SEI Bridge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://sei.pe.gov.br/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://andersong2021.github.io/*",
      "https://dgmcg-ses-pe.github.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["content-sei.js"],
      "matches": [
        "https://sei.pe.gov.br/*"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
